# Icechunk store to render. Leave unset to see the placeholder empty state.
#
# The CERES EBAF store is mirrored to GCS (leap-public), which serves CORS
# headers for browser reads, so no dev proxy is needed:
NEXT_PUBLIC_ICECHUNK_URL=https://storage.googleapis.com/leap-public/data/CERES_EBAF/store.icechunk
#
# Original OSN source (no CORS headers, needs a proxy or CORS-enabled mirror):
# NEXT_PUBLIC_ICECHUNK_URL=https://nyu1.osn.mghpcc.org/leap-pangeo-pipeline/CERES_EBAF/store_auto_clim.icechunk
#
# For a smoke test against a known-good public store (IMERG precipitation):
# NEXT_PUBLIC_ICECHUNK_URL=https://carbonplan-share.s3.us-west-2.amazonaws.com/zarr-layer-examples/pipeline/multi_level_virtual_hybrid_icechunk.icechunk

# Password auth (@carbonplan/auth). Server-side only, never NEXT_PUBLIC_.
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
USER_PASSWORD=
